;;; ntfy-smoke-test.el --- Offline notification regression tests -*- lexical-binding: t; -*-

(require 'cl-lib)
(require 'ert)
(require 'ntfy)

(ert-deftest ntfy-default-message-uses-configured-title ()
  (let ((ntfy-server "https://notifications.invalid")
        (ntfy-topic "package-test")
        (ntfy-title "Configured title")
        (ntfy-tags '("test"))
        (ntfy-priority 3)
        request)
    (cl-letf (((symbol-function 'url-retrieve-synchronously)
               (lambda (url &rest _)
                 (setq request (list url url-request-method url-request-data
                                     url-request-extra-headers))
                 'mock-response)))
      (ntfy-message "offline payload"))
    (should (equal (nth 0 request) "https://notifications.invalid/package-test"))
    (should (equal (nth 1 request) "POST"))
    (should (equal (nth 2 request) "offline payload"))
    (should (equal (cdr (assoc "Title" (nth 3 request))) "Configured title"))
    (should (equal (cdr (assoc "Tags" (nth 3 request))) "test"))
    (should (equal (cdr (assoc "Priority" (nth 3 request))) "3"))))

(ert-deftest ntfy-explicit-title-overrides-default ()
  (let ((ntfy-server "https://notifications.invalid")
        (ntfy-topic "package-test")
        (ntfy-title "Default")
        (ntfy-tags '("test"))
        (ntfy-priority 3)
        headers)
    (cl-letf (((symbol-function 'url-retrieve-synchronously)
               (lambda (&rest _)
                 (setq headers url-request-extra-headers)
                 'mock-response)))
      (ntfy-message-with-title "Override" "offline payload"))
    (should (equal (cdr (assoc "Title" headers)) "Override"))))

(ert-deftest ntfy-invalid-priority-never-sends ()
  (let ((ntfy-title "Title")
        (ntfy-tags '("test"))
        (sent nil))
    (cl-letf (((symbol-function 'url-retrieve-synchronously)
               (lambda (&rest _) (setq sent t))))
      (should-error (ntfy--publish-message "payload" "Title" '("test") 0)
                    :type 'user-error)
      (should-error (ntfy--publish-message "payload" "Title" '("test") 6)
                    :type 'user-error))
    (should-not sent)))
